{
  "name": "budget-ledger",
  "description": "Local-first personal and business budgeting desktop app.",
  "private": true,
  "version": "1.0.1",
  "releaseTag": "beta1.19",
  "author": "Budget Ledger",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "backend": "python backend/main.py",
    "build:backend": "python -m PyInstaller --noconfirm --onefile --name budget-ledger-backend --distpath backend/dist --workpath backend/build --specpath backend backend/main.py",
    "start": "concurrently -k \"npm run backend\" \"npm run dev\"",
    "dist": "npm run build && npm run build:backend && electron-builder --publish never",
    "dist:win": "npm run build && npm run build:backend && electron-builder --win nsis --x64 --publish never",
    "dist:win:local": "npm run build && npm run build:backend && electron-builder --win nsis --x64 --publish never -c.win.signAndEditExecutable=false",
    "dist:mac": "npm run build && npm run build:backend && electron-builder --mac dmg --x64 --arm64 --publish never",
    "dist:linux": "npm run build && npm run build:backend && electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "emoji-picker-react": "^4.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.budgetledger.app",
    "productName": "Budget Ledger",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "icon": "electron/assets/icon.icns",
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "electron/assets/icon-512.png",
      "category": "Office;Finance;",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
